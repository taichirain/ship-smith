# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shipsmith
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shipsmith

# JWT
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# API
API_PREFIX=/api/v1
ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Health monitoring
AGENT_OFFLINE_THRESHOLD_SECONDS=600
AGENT_MONITOR_INTERVAL_SECONDS=60
HEALTH_MONITOR_ENABLED=true
