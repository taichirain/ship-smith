# Copy to .env.production and replace every placeholder.
# Production validation rejects placeholders and example.com values.
ENV=production
POSTGRES_USER=shipsmith
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=shipsmith

JWT_SECRET_KEY=replace-with-openssl-rand-base64-48
GIT_CREDENTIALS_SECRET_KEY=replace-with-another-openssl-rand-base64-48
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password

CORS_ORIGINS=https://shipsmith.example.com
PUBLIC_CORE_URL=https://shipsmith.example.com
INSTALL_SCRIPT_URL=https://shipsmith.example.com/install.sh

AGENT_OFFLINE_THRESHOLD_SECONDS=600
AGENT_MONITOR_INTERVAL_SECONDS=60
HEALTH_MONITOR_ENABLED=true
RUN_MIGRATIONS=0

# Optional:
# LLM_ENABLED=false
