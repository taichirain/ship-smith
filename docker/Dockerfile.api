# syntax=docker/dockerfile:1
FROM python:3.12-slim

# Package index mirrors are selectable at build time (see scripts/build_shipsmith_image.sh):
#   --build-arg APT_MIRROR=mirrors.aliyun.com
#   --build-arg PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG APT_MIRROR=""
ARG PIP_INDEX_URL=""

WORKDIR /app

RUN if [ -n "$APT_MIRROR" ]; then \
      sed -i "s|deb.debian.org|$APT_MIRROR|g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev postgresql-client git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY docker/entrypoint-api.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

COPY packages /app/packages
COPY apps/api /app/apps/api

# Persistent pip cache across builds (BuildKit); dependencies are only
# downloaded again when the requirement set actually changes.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install ${PIP_INDEX_URL:+--index-url "$PIP_INDEX_URL"} \
    -e /app/packages/config \
    -e /app/packages/db \
    -e /app/apps/api \
    "bcrypt==4.0.1" \
    psycopg2-binary

EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]